[Unit]
Description=Import members' correspondence into the CRM (in-container)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Prévient en cas d'échec (unité modèle alerte@.service). Sans cette ligne,
# une panne ne se voit que dans le journal, c'est-à-dire par personne.
OnFailure=alerte@%n.service

[Service]
Type=oneshot
# Runs every 10 minutes: never let two runs overlap on the same mailbox.
# (systemd already refuses to start a service that is still running; this
# states the intent for anyone shortening the interval further.)
# utils/ est dans l'image (deploy/Dockerfile) : rien à recopier avant le passage.

# Reads the audit mailbox that the Gmail routing rule copies member↔élu mail into.
# Secrets file supplies MEMBER_IMAP_USER / MEMBER_IMAP_APP_PASSWORD; add
# IMPORT_AUTO_PUBLISH=1 there to publish straight to the mails table.
ExecStart=/usr/bin/docker exec \
    --env-file /opt/volunteer-apps/secrets/website-meeting.env \
    -e IMAP_DB_PATH=/app/meetings.db \
    website-meeting-app \
    python3 /app/utils/import_member_mails.py
