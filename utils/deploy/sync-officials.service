[Unit]
Description=Refresh sitting deputies, senators and government from official open data and upsert them into the CRM (in-container)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Prévient en cas d'échec (unité modèle alerte@.service). Sans cette ligne,
# une panne ne se voit que dans le journal, c'est-à-dire par personne.
OnFailure=alerte@%n.service

[Service]
Type=oneshot
# utils/ et actual_dataset/ sont dans l'image (deploy/Dockerfile) : plus de
# recopie avant chaque passage. Elle faisait un `rm -rf /app/utils` qui pouvait
# couper un autre travail en train de lire ces fichiers (civicrm-sync,
# import-member-mails). Les jeux de données de l'image servent de base si le
# téléchargement d'une chambre échoue.
# Downloads the AN dump (zip), the Sénat API JSON and the government list, then
# runs extract+insert per chamber. Each chamber is isolated; inserts are
# idempotent (departed members reported, never deleted).
ExecStart=/usr/bin/docker exec website-meeting-app python3 /app/utils/sync_officials.py
