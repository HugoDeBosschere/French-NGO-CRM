[Unit]
Description=Import campaign BCC mails into the CRM (runs inside the app container)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# The container image does not ship utils/, and a container restart drops any
# earlier copy, so refresh it from the server checkout before each run. Wipe any
# existing copy first: `docker cp` into an existing dir nests (/app/utils/utils)
# and would leave stale code behind.
ExecStartPre=-/usr/bin/docker exec website-meeting-app rm -rf /app/utils
ExecStartPre=/usr/bin/docker cp /opt/volunteer-apps/apps/website-meeting/utils website-meeting-app:/app/utils
# Run inside the container, as the user that owns meetings.db. The secrets file
# supplies IMAP_USER / IMAP_APP_PASSWORD; add IMPORT_AUTO_PUBLISH=1 there to
# switch the daily run from the moderation queue to direct publishing.
ExecStart=/usr/bin/docker exec \
    --env-file /opt/volunteer-apps/secrets/website-meeting.env \
    -e IMAP_DB_PATH=/app/meetings.db \
    website-meeting-app \
    python3 /app/utils/import_campaign_mails.py
