[Unit]
Description=Import campaign BCC mails into the CRM (runs inside the app container)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Prévient en cas d'échec (unité modèle alerte@.service). Sans cette ligne,
# une panne ne se voit que dans le journal, c'est-à-dire par personne.
OnFailure=alerte@%n.service

[Service]
Type=oneshot
# utils/ est dans l'image (deploy/Dockerfile) : rien à recopier avant le passage.
# La synchronisation des adresses, portraits et fiches depuis elus.json a sa
# propre unité (sync-elus.service, 05:55) : ici, précédée d'un « - », son échec
# était avalé et la synchro pouvait s'arrêter des mois sans que personne le
# sache. L'import reste insensible à cet échec — c'était la bonne intention —
# mais l'échec se signale désormais de son côté.
# Run inside the container, as the user that owns meetings.db. The secrets file
# supplies IMAP_USER / IMAP_APP_PASSWORD; add IMPORT_AUTO_PUBLISH=1 there to
# switch the daily run from the moderation queue to direct publishing.
ExecStart=/usr/bin/docker exec \
    --env-file /opt/volunteer-apps/secrets/website-meeting.env \
    -e IMAP_DB_PATH=/app/meetings.db \
    website-meeting-app \
    python3 /app/utils/import_campaign_mails.py
